set -e

rootdir=$(readlink -f $(dirname $(readlink -f "$0"))/..)

[[ -e "$rootdir/.mountenv" ]] && source "$rootdir/.mountenv"

"$rootdir/scripts/rpc.py" $FSDEV_FUSE_RPC_OPTIONS fuse_mount "$1" "$2" \
	$FSDEV_FUSE_MOUNT_OPTIONS &>> "${FSDEV_FUSE_LOG:-/dev/null}"
