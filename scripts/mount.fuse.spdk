set -e

rootdir=$(readlink -f $(dirname $(readlink -f "$0"))/..)

waitformount() {
	local i pid fs mountpoint mnt

	pid=$1 fs=$2 mountpoint=$3
	for ((i = 0; i < 60; i++)); do
		kill -0 $pid || return 1
		if mnt=$(findmnt -rnc -S "$fs" -o SOURCE,TARGET) \
			&& [[ "$mnt" == "$fs $mountpoint" ]]; then
			return 0
		fi
		sleep 1s
	done
	return 1
}

[[ ! -e "$rootdir/.mountenv" ]] && echo "$rootdir/.mountenv is missing" >&2 && exit 1
. "$rootdir/.mountenv"

trap 'kill $fusepid' EXIT
"$rootdir/build/examples/fuse" -f "$1" -M "$2" \
	$FSDEV_FUSE_OPTIONS &>> "${FSDEV_FUSE_LOG:-/dev/null}" &
fusepid=$!

waitformount $fusepid "$1" "$2"
trap - EXIT
